[Unit]
Description=Kiosk browser watchdog
After=graphical.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__KIOSK_USER__
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/__KIOSK_USER__/.Xauthority
ExecStart=/usr/local/bin/kiosk-launch-browser
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
